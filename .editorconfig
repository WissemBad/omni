root = true

[*]
indent_size = 4
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,vue,js,mjs,json,yml,yaml,toml}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
