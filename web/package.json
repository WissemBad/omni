{
  "name": "omni-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "omni front-end: Nuxt + Wissem UI",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@wissem-industries/ui": "^1.2.0",
    "nuxt": "^4.6.4",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
